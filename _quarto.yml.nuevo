project:
  type: website
  output-dir: _outputs/html
  resources:
    - resources/**
    - status/**

profile:
  default: html

website:
  title: "Ingeniería Asistida por Sistemas Inteligentes"
  page-navigation: true

  announcement:
    dismissable: false
    content: "![](/resources/images/ants.png){.iasi-ants-image}"
    type: light
    position: above-navbar

  navbar:
    title: false 
    left:
      - text: "Manifiesto"
        href: manifesto.qmd
      - text: "Principios"
        href: principles.qmd
      - text: "Artefactos"
        href: artifacts/index.qmd
    right:
      - text: "ES"
        href: index.qmd
      - text: "EN"
        href: pages/en/index.qmd
      - icon: github
        href: https://github.com/iasi-org
        aria-label: GitHub

  page-footer:
    left: "IASI · Ingeniería Asistida por Sistemas Inteligentes"
    right:
      - text: GitHub
        href: https://github.com/iasi-org
